     ]
    }
   ],
   "source": [
    "# ---- 6. Scaling numeric features ----\n",
    "# Needed for models like KNN, SVM, Logistic Regression - not needed for trees\n",
    "scaler = StandardScaler()\n",
    "numeric_cols = [\"Age\", \"Fare\", \"FamilySize\"]\n",
    "df[numeric_cols] = scaler.fit_transform(df[numeric_cols])\n",
    "\n",
    "print(df.head())\n"
   ]
  },
  {
