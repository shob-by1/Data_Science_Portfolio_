   "source": [
    "# Titanic - Data Preprocessing & Feature Engineering\n",
    "# Dataset: https://www.kaggle.com/c/titanic/data (train.csv)\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
    "\n",
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "9dbef31f-bb42-4ad5-8023-1ac5f89baf9d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PassengerId      0\n",
      "Survived         0\n",
      "Pclass           0\n",
      "Name             0\n",
      "Sex              0\n",
      "Age            177\n",
      "SibSp            0\n",
      "Parch            0\n",
      "Ticket           0\n",
      "Fare             0\n",
      "Cabin          687\n",
      "Embarked         2\n",
      "dtype: int64\n"
     ]
    }
   ],
   "source": [
    "# ---- 1. Check missing values first ----\n",
    "print(df.isnull().sum())\n",
    "\n",
    "# Age       -> ~20% missing, numeric -> fill with median\n",
    "# Cabin     -> ~77% missing, too many to fill -> drop column\n",
    "# Embarked  -> only 2 missing, categorical -> fill \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "f23fa958-3c3a-42df-8227-ea206d636c08",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PassengerId    0\n",
      "Survived       0\n",
      "Pclass         0\n",
      "Name           0\n",
      "Sex            0\n",
      "Age            0\n",
      "SibSp          0\n",
      "Parch          0\n",
      "Ticket         0\n",
      "Fare           0\n",
      "Embarked       0\n",
      "dtype: int64\n"
     ]
    }
   ],
   "source": [
    "# ---- 2. Handle missing values ----\n",
    "\n",
    "# Age: fill with median (not mean, since age can be skewed by outliers)\n",
    "df[\"Age\"] = df[\"Age\"].fillna(df[\"Age\"].median())\n",
    "\n",
    "# Embarked: fill with the most common port\n",
    "df[\"Embarked\"] = df[\"Embarked\"].fillna(df[\"Embarked\"].mode()[0])\n",
    "\n",
    "# Cabin: too many missing, drop the column\n",
    "df = df.drop(columns=[\"Cabin\"])\n",
    "\n",
    "print(df.isnull().sum())   # should be all 0 now\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "206651c1-2942-4947-b266-e5dbc72b59a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---- 3. Drop columns that aren't useful as-is ----\n",
    "# Name and Ticket are free text, not usable directly without more work\n",
    "# PassengerId is just a row index\n",
    "df = df.drop(columns=[\"Name\", \"Ticket\", \"PassengerId\"])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "79f2ed90-63c4-431a-97d3-a07ea50f8fd5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   Survived  Pclass  Sex   Age  SibSp  Parch     Fare  Embarked_Q  Embarked_S\n",
      "0         0       3    0  22.0      1      0   7.2500       False        True\n",
      "1         1       1    1  38.0      1      0  71.2833       False       False\n",
      "2         1       3    1  26.0      0      0   7.9250       False        True\n",
      "3         1       1    1  35.0      1      0  53.1000       False        True\n",
      "4         0       3    0  35.0      0      0   8.0500       False        True\n",
      "Survived        int64\n",
      "Pclass          int64\n",
      "Sex             int64\n",
      "Age           float64\n",
      "SibSp           int64\n",
      "Parch           int64\n",
      "Fare          float64\n",
      "Embarked_Q       bool\n",
      "Embarked_S       bool\n",
      "dtype: object\n"
     ]
    }
   ],
   "source": [
    "# ---- 4. Categorical encoding ----\n",
    "\n",
    "# Sex: only 2 categories -> simple binary mapping\n",
    "df[\"Sex\"] = df[\"Sex\"].map({\"male\": 0, \"female\": 1})\n",
    "\n",
    "# Embarked: 3 categories, no natural order -> one-hot encoding\n",
    "df = pd.get_dummies(df, columns=[\"Embarked\"], drop_first=True)\n",
    "\n",
    "print(df.head())\n",
    "print(df.dtypes)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "a8472a12-52dc-4fa8-992e-40855457de0e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   Survived  Pclass  Sex   Age  SibSp  Parch     Fare  Embarked_Q  Embarked_S  \\\n",
      "0         0       3    0  22.0      1      0   7.2500       False        True   \n",
      "1         1       1    1  38.0      1      0  71.2833       False       False   \n",
      "2         1       3    1  26.0      0      0   7.9250       False        True   \n",
      "3         1       1    1  35.0      1      0  53.1000       False        True   \n",
      "4         0       3    0  35.0      0      0   8.0500       False        True   \n",
      "\n",
      "   FamilySize  IsAlone  AgeGroup_Teen  AgeGroup_Adult  AgeGroup_MiddleAge  \\\n",
      "0           2        0          False            True               False   \n",
      "1           2        0          False           False                True   \n",
      "2           1        1          False            True               False   \n",
      "3           2        0          False            True               False   \n",
      "4           1        1          False            True               False   \n",
      "\n",
      "   AgeGroup_Senior  FareBin_Mid  FareBin_High  FareBin_VeryHigh  \n",
      "0            False        False         False             False  \n",
      "1            False        False         False              True  \n",
      "2            False         True         False             False  \n",
      "3            False        False         False              True  \n",
      "4            False         True         False             False  \n"
     ]
    }
   ],
   "source": [
    "# ---- 5. Feature engineering ----\n",
    "\n",
    "# Family size from SibSp (siblings/spouses) + Parch (parents/children)\n",
    "df[\"FamilySize\"] = df[\"SibSp\"] + df[\"Parch\"] + 1\n",
    "\n",
    "# IsAlone flag - travelling solo often affected survival chances\n",
    "df[\"IsAlone\"] = (df[\"FamilySize\"] == 1).astype(int)\n",
    "\n",
    "# Bin Age into groups - sometimes ranges work better than raw age\n",
    "df[\"AgeGroup\"] = pd.cut(\n",
    "    df[\"Age\"],\n",
    "    bins=[0, 12, 18, 35, 60, 100],\n",
    "    labels=[\"Child\", \"Teen\", \"Adult\", \"MiddleAge\", \"Senior\"]\n",
    ")\n",
    "df = pd.get_dummies(df, columns=[\"AgeGroup\"], drop_first=True)\n",
    "\n",
    "# Bin Fare into quartiles - fare is heavily skewed, raw values aren't great for some models\n",
    "df[\"FareBin\"] = pd.qcut(df[\"Fare\"], 4, labels=[\"Low\", \"Mid\", \"High\", \"VeryHigh\"])\n",
    "df = pd.get_dummies(df, columns=[\"FareBin\"], drop_first=True)\n",
    "\n",
    "print(df.head())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "c4b53711-caf0-4910-95aa-d00acc375e99",
